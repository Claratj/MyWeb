{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for claratoloba.com. Source of truth: src/styles/tokens.css. Borrador 3 identity (plum · orange · teal) for a Frontend Engineer · Design Systems. Semantic tokens reference brand/derived tokens via {group.name} aliases.",
  "color": {
    "$type": "color",
    "brand": {
      "$description": "Borrador 3 brand palette (shared with Embr): plum = identity, orange = action, teal = calm/surface.",
      "plum": { "$value": "#4D0C3E", "$description": "headings, eyebrow, link, focus" },
      "orange": { "$value": "#C54120", "$description": "CTA fill, white text 5.06:1" },
      "orange-deep": { "$value": "#A2361A", "$description": "CTA hover and all orange text, 6.16:1 on n1" },
      "orange-light": { "$value": "#F38362", "$description": "the one orange on dark surfaces, 7.12:1 on d1" },
      "teal": { "$value": "#0A4544", "$description": "featured card, inverse surface" },
      "sage": { "$value": "#AAD8D0", "$description": "decorative only" },
      "sage-light": { "$value": "#CDE8E2", "$description": "text on teal and plum" }
    },
    "neutral": {
      "$description": "Light N1–N5 and dark D1–D4 (D5 is n1).",
      "n1": { "$value": "#F7F2F5", "$description": "page" },
      "n2": { "$value": "#FFFFFF", "$description": "surface" },
      "n3": { "$value": "#0B2027", "$description": "ink" },
      "n4": { "$value": "#46565B", "$description": "ink muted" },
      "n5": { "$value": "#D3D7D8", "$description": "line" },
      "n-alt": { "$value": "#ECE9EC", "$description": "subtle alt background" },
      "ink-caption": { "$value": "rgba(11, 32, 39, 0.62)", "$description": "captions, 4.60:1 on n1" },
      "d1": { "$value": "#101717", "$description": "dark page" },
      "d2": { "$value": "#1D2828", "$description": "dark surface" },
      "d3": { "$value": "#5A7775", "$description": "dark border" },
      "d4": { "$value": "#859F9E", "$description": "dark muted text" },
      "orange-light-hover": { "$value": "#F7B19B", "$description": "dark link hover" }
    },
    "alpha": {
      "$description": "Alpha variants for gradients, glows and overlays.",
      "n1-05": { "$value": "rgba(247, 242, 245, 0.05)" },
      "n1-14": { "$value": "rgba(247, 242, 245, 0.14)" },
      "n1-22": { "$value": "rgba(247, 242, 245, 0.22)" },
      "n1-92": { "$value": "rgba(247, 242, 245, 0.92)" },
      "teal-50": { "$value": "rgba(10, 69, 68, 0.5)" },
      "teal-18": { "$value": "rgba(10, 69, 68, 0.18)" },
      "teal-0": { "$value": "rgba(10, 69, 68, 0)" },
      "sage-22": { "$value": "rgba(170, 216, 208, 0.22)" },
      "sage-16": { "$value": "rgba(170, 216, 208, 0.16)" },
      "sage-0": { "$value": "rgba(170, 216, 208, 0)" },
      "orange-light-18": { "$value": "rgba(243, 131, 98, 0.18)" },
      "orange-light-0": { "$value": "rgba(243, 131, 98, 0)" }
    },
    "semantic": {
      "$description": "Role-based tokens (light). Components consume these. Dark overrides live in tokens.css under :root[data-theme=\"dark\"]. Legacy --c-* aliases in tokens.css are deprecated and not mirrored.",
      "bg": { "$value": "{color.neutral.n1}" },
      "bg-alt": { "$value": "{color.neutral.n-alt}" },
      "surface": { "$value": "{color.neutral.n2}" },
      "surface-invert": { "$value": "{color.brand.plum}" },
      "card": { "$value": "{color.brand.teal}" },
      "text": { "$value": "{color.neutral.n3}" },
      "text-muted": { "$value": "{color.neutral.n4}" },
      "text-caption": { "$value": "{color.neutral.ink-caption}" },
      "text-on-dark": { "$value": "{color.neutral.n1}" },
      "text-on-brand": { "$value": "{color.brand.sage-light}" },
      "heading": { "$value": "{color.brand.plum}" },
      "eyebrow": { "$value": "{color.brand.plum}" },
      "primary": { "$value": "{color.brand.orange}" },
      "cta": { "$value": "{color.brand.orange}" },
      "cta-hover": { "$value": "{color.brand.orange-deep}" },
      "cta-text": { "$value": "{color.brand.orange-deep}" },
      "link": { "$value": "{color.brand.plum}" },
      "link-hover": { "$value": "{color.brand.orange-deep}" },
      "border": { "$value": "{color.neutral.n5}" },
      "focus": { "$value": "{color.brand.plum}" },
      "decor": { "$value": "{color.brand.sage}" },
      "selection-bg": { "$value": "{color.brand.sage}" },
      "selection-text": { "$value": "{color.brand.teal}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": ["Montserrat", "Segoe UI", "system-ui", "sans-serif"],
        "$description": "display / headings; weights 600/700/800"
      },
      "body": {
        "$value": ["Mulish", "system-ui", "-apple-system", "sans-serif"],
        "$description": "body; weights 400/500/600/700"
      },
      "ornament": {
        "$value": ["Georgia", "Times New Roman", "serif"],
        "$description": "hero quotation-mark watermarks only"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Compact, editorial fluid scale. Fluid values are clamp() strings (min → preferred → max).",
      "eyebrow": { "$value": "0.75rem", "$description": "12px" },
      "caption": { "$value": "0.8125rem", "$description": "13px" },
      "body": { "$value": "0.9375rem", "$description": "15px" },
      "body-lg": { "$value": "clamp(1rem, 0.25vw + 0.95rem, 1.0625rem)", "$description": "~16–17px" },
      "h4": { "$value": "clamp(1rem, 0.4vw + 0.9rem, 1.1875rem)", "$description": "~16–19px" },
      "h3": { "$value": "clamp(1.1875rem, 0.7vw + 1rem, 1.5rem)", "$description": "~19–24px" },
      "h2": { "$value": "clamp(1.5rem, 1.6vw + 1.05rem, 2.125rem)", "$description": "~24–34px" },
      "h1": { "$value": "clamp(2rem, 3.4vw + 1rem, 3.25rem)", "$description": "~32–52px" },
      "button": { "$value": "0.75rem", "$description": "12px — pill button label" },
      "button-xs": { "$value": "0.6875rem", "$description": "11px — xs nav pill label" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.2 },
      "normal": { "$value": 1.6 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "eyebrow": { "$value": "0.14em" },
      "tight": { "$value": "-0.02em" },
      "button": { "$value": "0.7px" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "8px base scale.",
    "1": { "$value": "0.25rem", "$description": "4px" },
    "2": { "$value": "0.5rem", "$description": "8px" },
    "3": { "$value": "0.75rem", "$description": "12px" },
    "4": { "$value": "1rem", "$description": "16px" },
    "5": { "$value": "1.5rem", "$description": "24px" },
    "6": { "$value": "2rem", "$description": "32px" },
    "7": { "$value": "3rem", "$description": "48px" },
    "8": { "$value": "4rem", "$description": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "lg": { "$value": "20px" },
    "pill": { "$value": "100px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": [{"offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "rgba(11, 32, 39, 0.06)"}, {"offsetX": "0", "offsetY": "2px", "blur": "6px", "spread": "0", "color": "rgba(11, 32, 39, 0.05)"}]
    },
    "md": {
      "$value": {
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0",
        "color": "rgba(11, 32, 39, 0.1)"
      }
    },
    "lg": {
      "$value": {
        "offsetX": "0",
        "offsetY": "18px",
        "blur": "48px",
        "spread": "0",
        "color": "rgba(77, 12, 62, 0.18)"
      }
    },
    "nav": {
      "$value": {
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "28px",
        "spread": "0",
        "color": "rgba(11, 32, 39, 0.06)"
      },
      "$description": "soft shadow on scrolled nav"
    },
    "on-dark": {
      "$value": {
        "offsetX": "0",
        "offsetY": "6px",
        "blur": "18px",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0.18)"
      },
      "$description": "button on dark (plum) surfaces"
    },
    "on-dark-hover": {
      "$value": {
        "offsetX": "0",
        "offsetY": "10px",
        "blur": "24px",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0.26)"
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "container-max": { "$value": "1140px" },
    "container-pad": { "$value": "clamp(1.25rem, 4vw, 3rem)" },
    "section-gap": { "$value": "clamp(4rem, 9vw, 8rem)" }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [0.22, 1, 0.36, 1]
      }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "140ms" },
      "base": { "$value": "240ms" }
    }
  },
  "z": {
    "$type": "number",
    "nav": { "$value": 100 }
  }
}
